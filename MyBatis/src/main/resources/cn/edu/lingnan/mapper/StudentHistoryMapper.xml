<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.edu.lingnan.mapper.StudentHistoryMapper">
    <cache/>
    <sql id="mysql01">
        <if test="sname != null">
            sname like concat('%',#{sname},'%')
        </if>
        <if test="sright != null">
            and sright = #{sright}
        </if>
        <if test="sflag != null">
            and sflag = #{sflag}
        </if>
    </sql>

    <select id="queryStudentUseIf" parameterType="map" resultType="student">
        select * from studenthistory
        <trim prefix="WHERE" prefixOverrides="AND|OR">
            <include refid="mysql01"/>
        </trim>
    </select>


</mapper>