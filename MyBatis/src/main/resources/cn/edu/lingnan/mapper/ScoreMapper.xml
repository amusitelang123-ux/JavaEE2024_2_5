<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.edu.lingnan.mapper.ScoreMapper">
    <select id="queryScoreCidBySid" parameterType="string" resultType="string">
        select cid from score where sid = #{_sid}
    </select>
    <select id="queryScoreNumByCid" parameterType="string" resultType="int">
        select count(*) as num from score where cid = #{_cid}
    </select>
    <delete id="deleteScoreBySid" parameterType="string">
        delete from score where sid = #{_sid}
    </delete>
</mapper>