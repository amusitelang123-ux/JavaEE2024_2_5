<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.edu.lingnan.mapper.StudentMapper">
    <select id="queryStudentAll" resultType="cn.edu.lingnan.pojo.Student">
        select * from student
    </select>
    <select id="queryStudentBySid" resultType="cn.edu.lingnan.pojo.Student" parameterType="String">
        select * from student where sid = #{_sid}
    </select>
</mapper>