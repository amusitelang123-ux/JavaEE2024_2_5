<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.edu.lingnan.mapper.ScoreHistoryMapper">

    <cache/>
    <select id="queryScore" parameterType="map" resultType="score">
        select * from scorehistory
        <trim prefix="WHERE" prefixOverrides="AND|OR">
            <if test="sid != null">
                sid = #{sid}
            </if>
            <if test="cid != null">
                and cid = #{cid}
            </if>
            <if test="score != null">
                and score = #{score}
            </if>
            <if test="scflag != null">
                and scflag = ${scflag}
            </if>
        </trim>
    </select>
</mapper>