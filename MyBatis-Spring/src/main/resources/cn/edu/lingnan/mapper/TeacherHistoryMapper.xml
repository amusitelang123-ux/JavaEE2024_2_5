<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.edu.lingnan.mapper.TeacherHistoryMapper">
    <cache/>
    <select id="queryTeacher" parameterType="map" resultType="teacher">
        select * from teacherhistory
        <trim prefix="WHERE" prefixOverrides="AND|OR">
            <if test="tname != null">
                tname like concat('%',#{tname},'%')
            </if>
            <if test="tright != null">
                and tright = #{tright}
            </if>
            <if test="tflag != null">
                and tflag = #{tflag}
            </if>
        </trim>
    </select>
</mapper>