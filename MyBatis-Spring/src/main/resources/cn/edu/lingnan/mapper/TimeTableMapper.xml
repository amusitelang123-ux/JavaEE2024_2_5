<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.edu.lingnan.mapper.TimeTableMapper">
<!--    <delete id="deleteTimeTableByCid" parameterType="string">-->
<!--        delete from timetable where cid = #{_cid}-->
<!--    </delete>-->
    <cache/>
<update id="updateTimeTableByTidAndCid" parameterType="map">
    update timetable
    <trim prefix="set" suffixOverrides=",">
        <if test="classroom != null">
            classroom = #{classroom},
        </if>
        <if test="classtime != null">
            classtime = #{classtime},
        </if>
        <if test="ttflag != null">
            ttflag = #{ttflag}
        </if>
    </trim>
    where tid = #{tid} and cid = #{cid}
</update>
<select id="queryTimeTable" parameterType="map" resultType="timetable">
    select * from timetable
    <trim prefix="WHERE" prefixOverrides="AND|OR">
        <if test="tid != null">
            tid = #{tid}
        </if>
        <if test="cid != null">
            and cid = #{cid}
        </if>
        <if test="classroom != null">
            and classroom = #{classroom}
        </if>
        <if test="classtime != null">
            and classtime = #{classtime}
        </if>
        <if test="ttflag != null">
            and ttflag = #{ttflag}
        </if>
    </trim>
</select>
</mapper>